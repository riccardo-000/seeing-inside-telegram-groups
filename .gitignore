# ------------------------------------------------------------------
# SECRETS — never commit.
# Telethon .session files are live credentials for a Telegram account.
# ------------------------------------------------------------------
*.session
*.session-journal
.env
.env.*
!.env.example

# ------------------------------------------------------------------
# DATA — raw data IS shared through this private repo (team decision
# 2026-09-22, see memory/decisions.md). Only local DB files are ignored.
# GitHub rejects files > 100 MB: split dumps per chat / gzip them.
# ------------------------------------------------------------------
*.sqlite
*.db

# ------------------------------------------------------------------
# Python / tooling
# ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.ipynb_checkpoints

# ------------------------------------------------------------------
# OS / editors
# ------------------------------------------------------------------
.DS_Store
.vscode/
.idea/

# ------------------------------------------------------------------
# Local AI session state (shared memory lives in memory/, not here)
# ------------------------------------------------------------------
.claude/settings.local.json
