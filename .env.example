# Copy to .env and fill in with YOUR values (https://my.telegram.org -> API development tools).
# .env is gitignored. Never commit real values.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_PHONE=+450000000000

# Optional
TELEGRAM_SESSION_NAME=research
# Secret salt for pseudonymizing user IDs (HMAC). Share out-of-band, never commit.
PSEUDONYM_SALT=change-me
