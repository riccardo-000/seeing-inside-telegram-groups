# Copy to .env and fill in with YOUR values (https://my.telegram.org -> API development tools).
# .env is gitignored. Never commit real values.
# Two research accounts, one per study arm; scripts pick one with --topic crypto|conspiracy.

# --- crypto account ---
TELEGRAM_API_ID_CRYPTO=1234567
TELEGRAM_API_HASH_CRYPTO=0123456789abcdef0123456789abcdef
TELEGRAM_PHONE_CRYPTO=+450000000000
TELEGRAM_SESSION_NAME_CRYPTO=research

# --- conspiracy account ---
TELEGRAM_API_ID_CONSPIRACY=7654321
TELEGRAM_API_HASH_CONSPIRACY=fedcba9876543210fedcba9876543210
TELEGRAM_PHONE_CONSPIRACY=+450000000001
TELEGRAM_SESSION_NAME_CONSPIRACY=research_conspiracy

# --- shared ---
# Secret salt for pseudonymizing user IDs (HMAC). Same for both accounts. Share out-of-band, never commit.
PSEUDONYM_SALT=change-me

# Older .env files without suffix (TELEGRAM_API_ID=...) still work: they are read as the crypto account.
